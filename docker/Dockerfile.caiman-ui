# ── caiman-ui ──────────────────────────────────────────────────────────────
# Copia el build estático pre-generado con: cd ui && npm run build
FROM nginx:1.25-alpine

LABEL org.opencontainers.image.title="caiman-ui"
LABEL org.opencontainers.image.source="https://github.com/teampmladv/caiman-os"
LABEL org.opencontainers.image.licenses="Apache-2.0"

# Build pre-generado (generado por: cd ui && npm ci && npm run build)
COPY ui/dist /usr/share/nginx/html

RUN printf 'server {\n\
    listen 80;\n\
    root /usr/share/nginx/html;\n\
    index index.html;\n\
    location / { try_files $uri $uri/ /index.html; }\n\
    location /api { proxy_pass http://caiman-api:8765; }\n\
    location /ws {\n\
        proxy_pass http://caiman-api:8765;\n\
        proxy_http_version 1.1;\n\
        proxy_set_header Upgrade $http_upgrade;\n\
        proxy_set_header Connection "upgrade";\n\
    }\n\
}\n' > /etc/nginx/conf.d/default.conf

EXPOSE 80
