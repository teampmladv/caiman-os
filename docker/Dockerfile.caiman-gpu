FROM debian:bookworm-slim
LABEL org.opencontainers.image.title="caiman-gpu"
LABEL org.opencontainers.image.source="https://github.com/teampmladv/caiman-os"
LABEL org.opencontainers.image.licenses="Apache-2.0"

RUN apt-get update -qq && apt-get install -y --no-install-recommends \
    libssl3 ca-certificates pciutils kmod \
    && rm -rf /var/lib/apt/lists/*

COPY target/release/caiman-gpu /usr/local/bin/caiman-gpu
RUN chmod +x /usr/local/bin/caiman-gpu

# Requires NVIDIA drivers on the host + --runtime=nvidia
# docker run --gpus all ghcr.io/teampmladv/caiman-gpu
EXPOSE 8769
ENTRYPOINT ["/usr/local/bin/caiman-gpu"]
